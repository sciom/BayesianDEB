\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Prior-to-posterior contraction $c$ for different data sizes and prior widths (individual growth model, simulated \emph  {E.~fetida} data, $N_t = 13$). Columns A use moderately informative priors ($\sigma = 0.5$); column~B uses the package defaults ($\sigma = 1.0$). Values near~0 indicate prior-dominated posteriors; near~1 data-dominated. The entry for $[E_G]$ under default priors is omitted because the default $[E_G]$ prior ($\sigma = 1.0$) produced frequent ODE solver failures during MCMC warmup, preventing reliable estimation.}}{21}{table.9}\protected@file@percent }
\newlabel{tab:contraction}{{9}{21}{Prior-to-posterior contraction $c$ for different data sizes and prior widths (individual growth model, simulated \emph {E.~fetida} data, $N_t = 13$). Columns A use moderately informative priors ($\sigma = 0.5$); column~B uses the package defaults ($\sigma = 1.0$). Values near~0 indicate prior-dominated posteriors; near~1 data-dominated. The entry for $\EG $ under default priors is omitted because the default $\EG $ prior ($\sigma = 1.0$) produced frequent ODE solver failures during MCMC warmup, preventing reliable estimation}{table.9}{}}
